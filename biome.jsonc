{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/*.css",
      "!src/project/demo/*.json",
      "!.github/ISSUE_TEMPLATE"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": { "useLiteralKeys": "off" },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useSelfClosingElements": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["assert", "error", "info", "warn"] }
        },
        "noDebugger": "error",
        "noVar": "error",
        "noDoubleEquals": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      // The 2.6 markdown formatter widens a table cell holding an HTML comment by one
      // space on every run, and these files key each row with a shortcut-action comment.
      "includes": ["docs/*/shortcuts.md"],
      "formatter": { "enabled": false }
    },
    {
      // Playwright's locator.innerText() reads rendered text over the protocol;
      // it is not DOM Node.innerText, and textContent() would include hidden text.
      "includes": ["scripts/e2e/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useImportType": "off" }
        }
      }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
