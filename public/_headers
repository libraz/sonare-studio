/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: cross-origin

/*.wasm
  Content-Type: application/wasm

# Everything under /assets is content-addressed, so its bytes never change under
# a given name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker, the release manifest it validates itself against and the document
# that names this release's assets must never be answered from a stale cache: a
# worker paired with another release's manifest cannot install at all, and one
# paired with another release's document boots an app whose assets it does not
# hold.
/sw.js
  Cache-Control: no-cache

/precache-manifest.json
  Cache-Control: no-cache

/worklet-manifest.json
  Cache-Control: no-cache

# The root is the canonical app shell. Keep /index.html revalidated for legacy
# workers and the host's clean-URL redirect to /.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
