{
  "name": "sonare-studio",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "yarn build:worklet && vite",
    "build": "yarn build:worklet && vue-tsc --noEmit && vite build",
    "build:worklet": "vite build --config vite.worklet.config.ts",
    "preview": "vite preview",
    "copy:wasm": "./scripts/copy-wasm.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:external-formats": "EXTERNAL_VALIDATORS=1 vitest run tests/external-format-validators.spec.ts tests/external-format-fuzz.spec.ts tests/archive-preflight.spec.ts tests/persistence-szd.spec.ts tests/persistence-backup.spec.ts tests/export-dawproject.spec.ts tests/import-dawproject.spec.ts tests/project-smf.spec.ts tests/notation-musicxml.spec.ts tests/notation-musicxml-import.spec.ts tests/export-wav.spec.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ncu": "NO_UPDATE_NOTIFIER=1 ncu",
    "ncu:update": "NO_UPDATE_NOTIFIER=1 ncu -u",
    "typecheck": "vue-tsc --noEmit",
    "verify": "yarn lint && yarn test && yarn test:external-formats && yarn build"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@libraz/libcantus": "1.3.0",
    "@vue/devtools-api": "^8.2.1",
    "fflate": "^0.8",
    "jspdf": "^4.2.1",
    "pinia": "^4",
    "saxes": "^6.0.0",
    "svg2pdf.js": "^2.8.1",
    "verovio": "^6",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5",
    "jsdom": "^30",
    "npm-check-updates": "^23.1.1",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^5",
    "vue-tsc": "^3"
  }
}
