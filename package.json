{
  "name": "sonare-studio",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "dev": "vite",
    "build": "yarn build:worklet && vue-tsc --noEmit && vite build",
    "build:worklet": "vite build --config vite.worklet.config.ts",
    "preview": "vite preview",
    "copy:wasm": "./scripts/copy-wasm.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "vue-tsc --noEmit",
    "verify": "yarn lint && yarn test && yarn build"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "fflate": "^0.8",
    "jspdf": "^4.2.1",
    "pinia": "^3",
    "svg2pdf.js": "^2.7.0",
    "verovio": "^6",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.4",
    "jsdom": "^29",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "vue-tsc": "^3"
  },
  "volta": {
    "node": "24.0.0",
    "yarn": "4.15.0"
  }
}
